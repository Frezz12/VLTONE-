          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nVLT_NODE vlt::AudioFrame process(\n    VLT_PORT(\"input\") vlt::AudioFrame input,\n    VLT_PORT(\"gain\") float gain = 1.0f)\n{\n    return input * vlt::clamp(gain, 0.0f, 2.0f);\n}\n",
