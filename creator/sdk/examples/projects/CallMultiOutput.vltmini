              "default": 0.10000000149011612,
              "id": "threshold",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "threshold",
              "signature": "",
              "type": "number"
            },
            {
              "cppType": "vlt::Function<Levels (vlt::AudioFrame, float)>",
              "default": 0.0,
              "id": "analyze",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "analyze",
              "signature": "struct:audio;number;gate;(audio;number;)",
              "type": "function"
            }
          ],
          "outputs": [
            {
              "cppType": "vlt::AudioFrame",
              "default": 0.0,
              "id": "out",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "Output",
              "signature": "",
              "type": "audio"
            }
          ],
          "prepare": false,
          "reset": false,
          "returnType": "vlt::AudioFrame",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nstruct Levels {\n    vlt::AudioFrame audio;\n    float envelope;\n    bool gate;\n};\n\nVLT_NODE vlt::AudioFrame process(\n    VLT_PORT(\"input\") vlt::AudioFrame input,\n    VLT_PORT(\"threshold\") float threshold = 0.1f,\n    VLT_PORT(\"analyze\")\n        vlt::Function<Levels(vlt::AudioFrame, float)> analyze = {})\n{\n    // One call computes all three fields. Do not call analyze again per field.\n    const auto result = analyze(input, threshold);\n    return result.audio * (1.0f / (1.0f + result.envelope));\n}\n",
          "stateType": ""
        }
      },
      {
        "id": "ui",
        "type": "interface",
        "version": 1,
        "parameters": {}
      },
      {
        "id": "probe",
        "type": "cpp_function",
        "version": 1,
        "parameters": {},
        "function": {
          "aggregateReturn": true,
          "analyzedHash": "eb29bbe30580d21aa4ed32c4f87b53d7958581eeb04e4ded0bc9fd2c711cd2c1",
          "arguments": [
            "$state",
            "$context",
            "input",
            "threshold"
          ],
          "context": true,
          "entry": "process",
          "inputs": [
            {
              "cppType": "vlt::AudioFrame",
              "default": 0.0,
              "id": "input",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "input",
