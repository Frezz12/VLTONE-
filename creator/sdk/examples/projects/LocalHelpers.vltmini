          ],
          "outputs": [
            {
              "cppType": "vlt::AudioFrame",
              "default": 0.0,
              "id": "out",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "Output",
              "signature": "",
              "type": "audio"
            }
          ],
          "prepare": false,
          "reset": false,
          "returnType": "vlt::AudioFrame",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\n// This helper can also be moved with Extract function > saturate.\nfloat saturate(float sample, float drive)\n{\n    drive = vlt::clamp(drive, 0.1f, 6.0f);\n    return vlt::tanh(sample * drive) / vlt::tanh(drive);\n}\n\nVLT_NODE vlt::AudioFrame process(\n    VLT_PORT(\"input\") vlt::AudioFrame input,\n    VLT_PORT(\"drive\") float drive = 1.5f,\n    VLT_PORT(\"mix\") float mix = 0.3f)\n{\n    const vlt::AudioFrame wet{\n        saturate(input.left, drive), saturate(input.right, drive)};\n    return vlt::mix(input, wet, vlt::clamp(mix, 0.0f, 1.0f));\n}\n",
          "stateType": ""
        }
      },
