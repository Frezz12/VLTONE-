            }
          ],
          "prepare": false,
          "reset": false,
          "returnType": "vlt::AudioFrame",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nVLT_NODE vlt::AudioFrame saturate(\n    VLT_PORT(\"input\") vlt::AudioFrame input,\n    VLT_PORT(\"drive\") float drive = 1.5f)\n{\n    drive = vlt::clamp(drive, 0.1f, 6.0f);\n    return vlt::tanh(input * drive) * (1.0f / vlt::tanh(drive));\n}\n",
          "stateType": ""
        }
      }
    ],
