          "outputs": [
            {
              "cppType": "vlt::AudioFrame",
              "default": 0.0,
              "id": "out",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "Output",
              "signature": "",
              "type": "audio"
            }
          ],
          "prepare": false,
          "reset": true,
          "returnType": "vlt::AudioFrame",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nstruct State {\n    vlt::AudioFrame history{};\n};\n\nvoid reset(State& state)\n{\n    state.history = {};\n}\n\nVLT_NODE vlt::AudioFrame process(\n    State& state, const vlt::Context& context,\n    VLT_PORT(\"input\") vlt::AudioFrame input,\n    VLT_PORT(\"cutoff\") float cutoff = 1500.0f)\n{\n    cutoff = vlt::clamp(cutoff, 20.0f, float(context.sampleRate * 0.45));\n    const float alpha = 1.0f - vlt::exp(\n        -6.28318530718f * cutoff / float(context.sampleRate));\n    state.history = state.history + (input - state.history) * alpha;\n    return state.history;\n}\n",
          "stateType": "State"
        }
      },
      {
        "id": "ui",
        "type": "interface",
        "version": 1,
        "parameters": {}
