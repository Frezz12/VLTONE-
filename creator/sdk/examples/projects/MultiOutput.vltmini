          "outputs": [
            {
              "cppType": "vlt::AudioFrame",
              "default": 0.0,
              "id": "audio",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "audio",
              "signature": "",
              "type": "audio"
            },
            {
              "cppType": "float",
              "default": 0.0,
              "id": "envelope",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "envelope",
              "signature": "",
              "type": "number"
            },
            {
              "cppType": "_Bool",
              "default": 0.0,
              "id": "gate",
              "max": 1.0,
              "min": 0.0,
              "name": "gate",
              "signature": "",
              "type": "gate"
            }
          ],
          "prepare": false,
          "reset": false,
          "returnType": "Outputs",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nstruct State {\n    float envelope = 0.0f;\n};\n\nstruct Outputs {\n    VLT_PORT(\"audio\") vlt::AudioFrame audio;\n    VLT_PORT(\"envelope\") float envelope;\n    VLT_PORT(\"gate\") bool gate;\n};\n\nVLT_NODE Outputs process(\n    State& state, const vlt::Context& context,\n    VLT_PORT(\"input\") vlt::AudioFrame input,\n    VLT_PORT(\"threshold\") float threshold = 0.1f)\n{\n    const float peak = std::max(std::abs(input.left), std::abs(input.right));\n    const float seconds = peak > state.envelope ? 0.005f : 0.1f;\n    const float alpha = 1.0f - vlt::exp(\n        -1.0f / (seconds * float(context.sampleRate)));\n    state.envelope += alpha * (peak - state.envelope);\n    return {input, state.envelope,\n            state.envelope > vlt::clamp(threshold, 0.0f, 1.0f)};\n}\n",
          "stateType": "State"
        }
      },
