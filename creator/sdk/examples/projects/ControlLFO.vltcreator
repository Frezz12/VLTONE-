          ],
          "context": true,
          "entry": "process",
          "inputs": [
            {
              "cppType": "float",
              "default": 1.0,
              "id": "rate",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "rate",
              "signature": "",
