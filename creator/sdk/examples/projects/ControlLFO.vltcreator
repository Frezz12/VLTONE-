            },
            {
              "cppType": "float",
              "default": 0.5,
              "id": "depth",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "depth",
              "signature": "",
              "type": "number"
            },
            {
              "cppType": "_Bool",
              "default": 0.0,
              "id": "reset",
              "max": 1.0,
              "min": 0.0,
              "name": "restart",
              "signature": "",
              "type": "gate"
            }
          ],
          "outputs": [
            {
              "cppType": "float",
              "default": 0.0,
              "id": "out",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "Output",
              "signature": "",
              "type": "number"
            }
          ],
          "prepare": false,
          "reset": false,
          "returnType": "float",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nstruct State {\n    double phase = 0.0;\n    bool previousReset = false;\n};\n\n// Number output: wire it to Gain.gain for a tremolo effect.\nVLT_NODE float process(\n    State& state, const vlt::Context& context,\n    VLT_PORT(\"rate\") float rate = 1.0f,\n    VLT_PORT(\"depth\") float depth = 0.5f,\n    VLT_PORT(\"reset\") bool restart = false)\n{\n    constexpr double twoPi = 6.283185307179586;\n    if (restart && !state.previousReset) state.phase = 0.0;\n    state.previousReset = restart;\n    const float wave = 0.5f + 0.5f * vlt::sin(float(state.phase));\n    state.phase += twoPi * double(vlt::clamp(rate, 0.01f, 20.0f))\n                   / context.sampleRate;\n    if (state.phase >= twoPi) state.phase -= twoPi;\n    return 1.0f - vlt::clamp(depth, 0.0f, 1.0f) * wave;\n}\n",
          "stateType": "State"
        }
      },
      {
