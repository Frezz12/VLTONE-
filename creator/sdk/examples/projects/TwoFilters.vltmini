            },
            {
              "cppType": "vlt::Function<vlt::AudioFrame (vlt::AudioFrame, float)>",
              "default": 0.0,
              "id": "filter_b",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "filterB",
              "signature": "value:audio;(audio;number;)",
              "type": "function"
            }
          ],
          "outputs": [
            {
              "cppType": "vlt::AudioFrame",
              "default": 0.0,
              "id": "out",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "Output",
              "signature": "",
              "type": "audio"
            }
          ],
          "prepare": false,
          "reset": false,
          "returnType": "vlt::AudioFrame",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nVLT_NODE vlt::AudioFrame process(\n    VLT_PORT(\"input\") vlt::AudioFrame input,\n    VLT_PORT(\"cutoff\") float cutoff = 500.0f,\n    VLT_PORT(\"mix\") float mix = 0.5f,\n    VLT_PORT(\"filter_a\")\n        vlt::Function<vlt::AudioFrame(vlt::AudioFrame, float)> filterA = {},\n    VLT_PORT(\"filter_b\")\n        vlt::Function<vlt::AudioFrame(vlt::AudioFrame, float)> filterB = {})\n{\n    // Connect the SAME OnePole function output to both function inputs.\n    // Each input owns independent filter history.\n    const auto low = filterA(input, cutoff);\n    const auto high = filterB(input, cutoff * 4.0f);\n    return vlt::mix(low, high, vlt::clamp(mix, 0.0f, 1.0f));\n}\n",
          "stateType": ""
        }
      },
      {
        "id": "ui",
        "type": "interface",
        "version": 1,
        "parameters": {}
      },
      {
        "id": "filter",
        "type": "cpp_function",
        "version": 1,
        "parameters": {},
        "function": {
          "aggregateReturn": false,
          "analyzedHash": "22e7a76e26ed5b28905f4ac05e1b4ac0a4ce1be2c049bf18766e52f4910b77e5",
          "arguments": [
            "$state",
            "$context",
            "input",
            "cutoff"
          ],
          "context": true,
          "entry": "process",
          "inputs": [
            {
              "cppType": "vlt::AudioFrame",
              "default": 0.0,
              "id": "input",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "input",
              "signature": "",
              "type": "audio"
            },
            {
              "cppType": "float",
              "default": 1500.0,
              "id": "cutoff",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "cutoff",
              "signature": "",
              "type": "number"
            }
          ],
          "outputs": [
            {
              "cppType": "vlt::AudioFrame",
              "default": 0.0,
              "id": "out",
              "max": 1000000.0,
              "min": -1000000.0,
              "name": "Output",
              "signature": "",
              "type": "audio"
            }
          ],
          "prepare": false,
          "reset": true,
          "returnType": "vlt::AudioFrame",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nstruct State {\n    vlt::AudioFrame history{};\n};\n\nvoid reset(State& state)\n{\n    state.history = {};\n}\n\nVLT_NODE vlt::AudioFrame process(\n    State& state, const vlt::Context& context,\n    VLT_PORT(\"input\") vlt::AudioFrame input,\n    VLT_PORT(\"cutoff\") float cutoff = 1500.0f)\n{\n    cutoff = vlt::clamp(cutoff, 20.0f, float(context.sampleRate * 0.45));\n    const float alpha = 1.0f - vlt::exp(\n        -6.28318530718f * cutoff / float(context.sampleRate));\n    state.history = state.history + (input - state.history) * alpha;\n    return state.history;\n}\n",
          "stateType": "State"
        }
      }
    ],
