          "prepare": false,
          "reset": false,
          "returnType": "float",
          "sdk": 1,
          "source": "#include <vlt/creator.hpp>\n\nfloat saturate(VLT_PORT(\"p_cf65cbd1de11346f975b\") float value, VLT_PORT(\"p_47e60511a144465fe6d4\") float drive) {\n  return vlt::tanh(value * drive) / drive;\n}\n",
