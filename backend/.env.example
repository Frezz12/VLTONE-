APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://vlt:vlt@localhost:5432/vltstudio?sslmode=disable
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
DESKTOP_API_ORIGIN=http://localhost:8080
STORAGE_ROOT=./storage
# 32-byte Ed25519 seed, base64 encoded. Development derives an explicit dev key when empty.
AUTH_SIGNING_SEED=
# Optional but recommended stable 32-byte base64 key for admin-managed provider
# credentials. Set it before adding models and keep it unchanged across deploys.
AI_CREDENTIALS_KEY=
TELEMETRY_CONSENT_VERSION=2026-08-23
AI_ENABLED=true
# Required and greater than zero when APP_ENV=production.
AI_GLOBAL_MONTHLY_TOKEN_LIMIT=0
# Multiplayer is deliberately disabled until command-mutation coverage and the
# collaboration acceptance suite pass in the release pipeline.
COLLABORATION_ENABLED=false
# V1 is designed and tested for at most eight simultaneous participants.
COLLAB_MAX_PARTICIPANTS=8
# Ask the current host for a canonical snapshot after either threshold.
COLLAB_SNAPSHOT_OPS=500
COLLAB_SNAPSHOT_SECONDS=300
COLLAB_SNAPSHOT_RETRY_SECONDS=15
# Recording leases are renewed by heartbeat; empty rooms get a reconnect grace.
COLLAB_LEASE_SECONDS=15
COLLAB_RECONNECT_SECONDS=30
# Participants whose authenticated heartbeat stops are evicted transactionally.
COLLAB_MEMBER_STALE_SECONDS=45
COLLAB_REAPER_BATCH=256
# Upload cleanup and blob GC are separately bounded because each selected row
# may require an object-storage request.
COLLAB_STORAGE_REAPER_BATCH=128
COLLAB_MAINTENANCE_TIMEOUT_SECONDS=20
# Verified blobs are deleted only after this no-reference retention window.
COLLAB_BLOB_RETENTION_SECONDS=604800
# Each WebSocket message gets a finite database deadline, and each room
# subscriber has both a message-count cap and a shared durable/ephemeral byte cap.
COLLAB_WS_DB_TIMEOUT_SECONDS=15
COLLAB_ROOM_QUEUE_BYTES=8388608
# Required when collaboration is enabled. The API uses path-style S3 requests;
# the endpoint must be an HTTPS origin in production (AWS S3, MinIO, R2, etc.).
COLLAB_OBJECT_ENDPOINT=
COLLAB_OBJECT_REGION=us-east-1
COLLAB_OBJECT_BUCKET=
COLLAB_OBJECT_ACCESS_KEY_ID=
COLLAB_OBJECT_SECRET_ACCESS_KEY=
# Optional for temporary provider credentials. Never expose these values in API
# responses or application logs.
COLLAB_OBJECT_SESSION_TOKEN=
# Presigned URLs are deliberately short-lived. Upload sessions survive long
# enough for a client to retry prepare and request a fresh URL.
COLLAB_UPLOAD_URL_SECONDS=900
COLLAB_DOWNLOAD_URL_SECONDS=300
COLLAB_UPLOAD_SESSION_SECONDS=86400
# Hard upper bound for server-side streaming verification (8 GiB by default).
COLLAB_MAX_OBJECT_BYTES=8589934592
# Objects at or above this size use provider-side S3 multipart upload. This
# threshold cannot exceed S3's 5 GiB single-PUT limit. Part bytes are a target;
# the server raises them when needed to stay within its strict 1000-part cap.
# Each prepare response returns at most this many missing
# presigned part URLs, so retries advance without an unbounded response.
# The bucket must also abort incomplete multipart uploads through a provider
# lifecycle rule; a process crash during provider create/CAS or verified final
# promotion can otherwise leave an unreachable provider upload.
COLLAB_MULTIPART_THRESHOLD_BYTES=67108864
COLLAB_MULTIPART_PART_BYTES=16777216
COLLAB_MULTIPART_URL_BATCH=100
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Password resets and new-crash alerts to every active administrator.
SMTP_FROM=VLT Studio <no-reply@example.com>
TRUSTED_PROXY_CIDRS=
