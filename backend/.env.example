APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://vlt:vlt@localhost:5432/vltstudio?sslmode=disable
PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
DESKTOP_API_ORIGIN=http://localhost:8080
STORAGE_ROOT=./storage
# 32-byte Ed25519 seed, base64 encoded. Development derives an explicit dev key when empty.
AUTH_SIGNING_SEED=
# Optional but recommended stable 32-byte base64 key for admin-managed provider
# credentials. Set it before adding models and keep it unchanged across deploys.
AI_CREDENTIALS_KEY=
TELEMETRY_CONSENT_VERSION=2026-08-23
AI_ENABLED=true
# Required and greater than zero when APP_ENV=production.
AI_GLOBAL_MONTHLY_TOKEN_LIMIT=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Password resets and new-crash alerts to every active administrator.
SMTP_FROM=VLT Studio <no-reply@example.com>
TRUSTED_PROXY_CIDRS=
