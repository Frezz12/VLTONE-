{
  "format": "vltcreator",
  "version": 1,
  "name": "Gentle Tremolo",
  "activeMode": "",
  "definition": {
    "id": "creator.example.tremolo",
    "name": "Gentle Tremolo",
    "version": 3,
    "appearance": {
      "theme": "graphite",
      "controlStyle": "machined",
      "backgroundColor": "",
      "backgroundImage": ""
    },
    "controls": [
      {
        "id": "rate",
        "name": "Rate",
        "unit": "Hz",
        "min": 0.1,
        "max": 10,
        "default": 1.8,
        "log": true,
        "bindings": [],
        "style": ""
      },
      {
        "id": "depth",
        "name": "Depth",
        "unit": "%",
        "min": 0,
        "max": 1,
        "default": 0.35,
        "log": false,
        "bindings": [],
        "style": ""
      }
    ],
    "nodes": [
      {
        "id": "input",
        "type": "input",
        "version": 1,
        "parameters": {}
      },
      {
        "id": "output",
        "type": "output",
        "version": 1,
        "parameters": {}
      },
      {
        "id": "interface",
        "type": "interface",
        "version": 1,
        "parameters": {}
      },
      {
        "id": "lfo",
        "type": "lfo",
        "version": 1,
        "parameters": {
          "amount": 0.5,
          "offset": 0.5,
          "rate": 1.8
        }
      },
      {
        "id": "gain",
        "type": "gain",
        "version": 1,
        "parameters": {}
      },
      {
        "id": "mix",
        "type": "mix",
        "version": 1,
        "parameters": {
          "mix": 0.35
        }
      }
    ],
    "connections": [
      {
        "from": "input",
        "fromPort": "out",
        "to": "gain",
        "toPort": "in"
      },
      {
        "from": "lfo",
        "fromPort": "out",
        "to": "gain",
        "toPort": "gain"
      },
      {
        "from": "interface",
        "fromPort": "rate",
        "to": "lfo",
        "toPort": "rate"
      },
      {
        "from": "interface",
        "fromPort": "depth",
        "to": "mix",
        "toPort": "mix"
      },
      {
        "from": "input",
        "fromPort": "out",
        "to": "mix",
        "toPort": "a"
      },
      {
        "from": "gain",
        "fromPort": "out",
        "to": "mix",
        "toPort": "b"
      },
      {
        "from": "mix",
        "fromPort": "out",
        "to": "output",
        "toPort": "in"
      }
    ]
  },
  "positions": {
    "": {
      "input": [
        30,
        60
      ],
      "gain": [
        650,
        60
      ],
      "mix": [
        970,
        60
      ],
      "output": [
        1280,
        60
      ],
      "interface": [
        30,
        280
      ],
      "lfo": [
        340,
        280
      ]
    }
  },
  "viewports": {
    "": {
      "center": [
        760,
        270
      ],
      "zoom": 0.45
    }
  }
}
