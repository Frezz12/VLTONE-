# Copy to /etc/vlt-account/api.env, replace every CHANGE_ME, then chmod 0600.
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://vlt:CHANGE_ME@127.0.0.1:5432/vltstudio?sslmode=disable
PUBLIC_ORIGIN=https://CHANGE_ME.example.com
ADMIN_ORIGIN=https://CHANGE_ME.example.com
DESKTOP_API_ORIGIN=https://CHANGE_ME.example.com
STORAGE_ROOT=/var/lib/vlt-account/storage
AUTH_SIGNING_SEED=CHANGE_ME_BASE64_32_BYTE_ED25519_SEED
# Stable random key used to hash collaboration invite codes. Generate once
# with `openssl rand -base64 32` and keep it unchanged across deployments.
VLT_INVITE_CODE_PEPPER=CHANGE_ME_BASE64_32_BYTE_KEY
AI_CREDENTIALS_KEY=
TELEMETRY_CONSENT_VERSION=2026-08-23
AI_ENABLED=false
AI_GLOBAL_MONTHLY_TOKEN_LIMIT=1

# Default-deny rollout. Account access is managed in the admin UI; the UUID
# list is an optional emergency OR override and should normally stay empty.
COLLABORATION_ENABLED=false
COLLAB_RECORDING_ENABLED=false
COLLAB_ALLOWED_USER_IDS=
COLLAB_MAX_PARTICIPANTS=8
COLLAB_SNAPSHOT_OPS=500
COLLAB_SNAPSHOT_SECONDS=300
COLLAB_SNAPSHOT_RETRY_SECONDS=15
COLLAB_LEASE_SECONDS=15
COLLAB_RECONNECT_SECONDS=30
COLLAB_MEMBER_STALE_SECONDS=45
COLLAB_REAPER_BATCH=256
COLLAB_STORAGE_REAPER_BATCH=128
COLLAB_MAINTENANCE_TIMEOUT_SECONDS=20
COLLAB_BLOB_RETENTION_SECONDS=604800
COLLAB_WS_DB_TIMEOUT_SECONDS=15
COLLAB_ROOM_QUEUE_BYTES=8388608

COLLAB_OBJECT_ENDPOINT=https://s3.example.com
COLLAB_OBJECT_REGION=us-east-1
COLLAB_OBJECT_BUCKET=CHANGE_ME
COLLAB_OBJECT_ACCESS_KEY_ID=CHANGE_ME
COLLAB_OBJECT_SECRET_ACCESS_KEY=CHANGE_ME
COLLAB_OBJECT_SESSION_TOKEN=
COLLAB_UPLOAD_URL_SECONDS=900
COLLAB_DOWNLOAD_URL_SECONDS=300
COLLAB_UPLOAD_SESSION_SECONDS=86400
COLLAB_MAX_OBJECT_BYTES=8589934592
COLLAB_PROJECT_QUOTA_BYTES=53687091200
COLLAB_USER_QUOTA_BYTES=107374182400
COLLAB_MAX_OPEN_UPLOADS_PER_USER=4
COLLAB_MAX_OPEN_UPLOADS_PER_PROJECT=8
COLLAB_VERIFY_WORKERS=2
COLLAB_MAX_VERIFY_PER_USER=1
COLLAB_MULTIPART_THRESHOLD_BYTES=67108864
COLLAB_MULTIPART_PART_BYTES=16777216
COLLAB_MULTIPART_URL_BATCH=100

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM='VLT Studio <CHANGE_ME@example.com>'
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
