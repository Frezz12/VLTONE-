@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/VltSpectreCoreTargets.cmake")
set(VltSpectre_Core_FOUND TRUE)
if("Widgets" IN_LIST VltSpectre_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/VltSpectreWidgetTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Qt6 6.2 COMPONENTS Widgets)
        include("${CMAKE_CURRENT_LIST_DIR}/VltSpectreWidgetTargets.cmake")
        set(VltSpectre_Widgets_FOUND TRUE)
    else()
        set(VltSpectre_Widgets_FOUND FALSE)
        set(VltSpectre_NOT_FOUND_MESSAGE "This installation was built without VLT_SPECTRE_BUILD_WIDGETS.")
    endif()
endif()
check_required_components(VltSpectre)